# =====================================================
# AquaPure Client — Environment Variables
# =====================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# All Vite env variables must be prefixed with VITE_
# =====================================================

# ---------------------------
# EmailJS Configuration
# Get these from: https://www.emailjs.com/
# Dashboard → Email Services / Email Templates / Account
# ---------------------------
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# ---------------------------
# App Configuration
# ---------------------------
VITE_APP_NAME=AquaPure
VITE_APP_URL=http://localhost:5173
# Base URL of the backend API. The /api prefix is appended automatically by
# src/services/api/apiClient.js, so do NOT include it here.
# Local dev:  http://localhost:5000
# Render prod: https://mineral-water-project.onrender.com  (set in Render env, not here)
VITE_API_URL=http://localhost:5000