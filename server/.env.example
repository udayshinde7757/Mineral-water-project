# =====================================================
# AquaPure Server — Environment Variables Example
# =====================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =====================================================

# ---------------------------
# Database Configuration
# ---------------------------
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# ---------------------------
# JWT Configuration
# ---------------------------
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# ---------------------------
# Server Configuration
# ---------------------------
PORT=5000
NODE_ENV=development

# ---------------------------
# CORS Configuration
# ---------------------------
CLIENT_URL=http://localhost:5173

# ---------------------------
# Email Configuration (Nodemailer / Gmail App Password)
# ---------------------------
CONTACT_EMAIL_ENABLED=true
COMPANY_EMAIL=your-email@gmail.com
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_FROM="AquaPure Mineral Water" <your-email@gmail.com>

# Email that receives new-order / owner notifications (falls back to COMPANY_EMAIL)
ADMIN_EMAIL=your-email@gmail.com

# Support email shown to customers in cancellation/refund emails
AQUAPURE_SUPPORT_EMAIL=support@aquapure.com

# ---------------------------
# WhatsApp Business Cloud API (Meta) Configuration
# ---------------------------
# Get these from: https://developers.facebook.com/docs/whatsapp/cloud-api
# WhatsApp Business App → WhatsApp → API Setup

# Graph API access token (starts with EAAG...)
WHATSAPP_ACCESS_TOKEN=

# Phone number ID from the API Setup tab (numeric)
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (numeric) — used for account-level API calls
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Optional Graph API base URL override (default: https://graph.facebook.com/v21.0)
# WHATSAPP_API_BASE=https://graph.facebook.com/v21.0

# Optional approved templates for order notifications. WhatsApp requires an
# approved template for business-initiated messages outside a 24h session.
# Expected body placeholders per template:
#   sendOrderPlacedMessage     → {{1}} Customer name | {{2}} Order ID
#                                {{3}} Total amount | {{4}} Estimated delivery
#   sendOutForDeliveryMessage  → {{1}} Customer name | {{2}} Order ID | {{3}} Total amount
#   sendOrderCompletedMessage  → {{1}} Customer name | {{2}} Order ID | {{3}} Total amount
#   sendOrderStatusWhatsApp    → {{1}} Customer name | {{2}} Order ID | {{3}} Status
#                                {{4}} Total amount | {{5}} Notes
WHATSAPP_ORDER_PLACED_TEMPLATE=
WHATSAPP_OUT_FOR_DELIVERY_TEMPLATE=
WHATSAPP_ORDER_COMPLETED_TEMPLATE=
WHATSAPP_STATUS_TEMPLATE=

# Approved template for owner/admin new-order notification.
# Expected body placeholders: {{1}} Customer name | {{2}} Phone | {{3}} Email
#   {{4}} Address | {{5}} Products | {{6}} Total | {{7}} Payment status
#   {{8}} Payment method | {{9}} Order ID | {{10}} Date & time
WHATSAPP_ADMIN_TEMPLATE=admin_new_order

# Owner/admin WhatsApp number to receive order alerts (with country code, no +)
ADMIN_WHATSAPP_NUMBER=919876543210

# WhatsApp number customers can reach for support (with country code, no +)
WHATSAPP_SUPPORT_NUMBER=919356212824

# Approved WhatsApp template for order cancellation with ONLINE payment (refund).
# Expected body placeholders: {{1}} Customer name | {{2}} Order ID
#   {{3}} Refund amount | {{4}} Refund status | {{5}} Expected credit timeframe
WHATSAPP_CANCELLATION_TEMPLATE=order_cancelled_refund

# Approved WhatsApp template for order cancellation with Cash on Delivery.
# Expected body placeholders: {{1}} Customer name | {{2}} Order ID
WHATSAPP_CANCELLATION_COD_TEMPLATE=order_cancelled_cod

# Approved WhatsApp template for owner/admin cancellation alert.
# Expected body placeholders: {{1}} Customer name | {{2}} Phone | {{3}} Order ID
#   {{4}} Amount | {{5}} Payment method | {{6}} Refund status
WHATSAPP_ADMIN_CANCELLATION_TEMPLATE=admin_order_cancelled

# Approved WhatsApp template for refund-completed notification to customer.
# Expected body placeholders: {{1}} Customer name | {{2}} Amount | {{3}} Order ID
WHATSAPP_REFUND_COMPLETED_TEMPLATE=refund_completed

# ---------------------------
# Payment Refunds (Razorpay)
# ---------------------------
# Same key_id / key_secret used for payments are reused for refunds.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Stripe is scaffolded for future use — set only when Stripe refunds are enabled.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# ---------------------------
# Rate Limiting
# ---------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# ---------------------------
# AquaChat (AI Chatbot) — Google Gemini
# ---------------------------
# Get an API key from https://aistudio.google.com/apikey
# Keep it server-side only — NEVER expose it to the browser.
GEMINI_API_KEY=your-gemini-api-key

# Gemini model used by AquaChat (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Optional: override the Gemini REST API base URL (advanced).
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta